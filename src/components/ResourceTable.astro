---
import AffiliateCTA from './AffiliateCTA.astro';

interface PaidResource {
  provider: string;
  type: string;
  price: string;
  best_for: string;
  affiliate_url: string;
  affiliate_label: string;
  affiliate_event: string;
  affiliate?: boolean;
  note?: string;
}
interface Props {
  resources: PaidResource[];
}

const { resources } = Astro.props;

const hasAffiliate = resources.some((r) => r.affiliate);
---

<!-- Desktop table -->
<div class="hidden md:block overflow-hidden rounded-xl" style="border: 1px solid var(--cb-border);">
  <table class="w-full text-sm">
    <thead>
      <tr style="background: var(--cb-bg-subtle); border-bottom: 1px solid var(--cb-border);">
        <th class="text-left px-4 py-3 font-semibold text-xs uppercase tracking-wide" style="color: var(--cb-text-sub);">Provider</th>
        <th class="text-left px-4 py-3 font-semibold text-xs uppercase tracking-wide" style="color: var(--cb-text-sub);">Type</th>
        <th class="text-left px-4 py-3 font-semibold text-xs uppercase tracking-wide" style="color: var(--cb-text-sub);">Price</th>
        <th class="text-left px-4 py-3 font-semibold text-xs uppercase tracking-wide" style="color: var(--cb-text-sub);">Best for</th>
        <th class="text-left px-4 py-3 font-semibold text-xs uppercase tracking-wide" style="color: var(--cb-text-sub);">Link</th>
      </tr>
    </thead>
    <tbody>
      {resources.map((r) => (
        <tr style="border-top: 1px solid var(--cb-border-sub); background: var(--cb-bg-card);"
          onmouseover="this.style.background='var(--cb-bg-subtle)'"
          onmouseout="this.style.background='var(--cb-bg-card)'"
        >
          <td class="px-4 py-3 font-medium" style="color: var(--cb-text);">{r.provider}</td>
          <td class="px-4 py-3" style="color: var(--cb-text-sub);">{r.type}</td>
          <td class="px-4 py-3 font-medium" style="color: var(--cb-text);">{r.price}</td>
          <td class="px-4 py-3 max-w-xs" style="color: var(--cb-text-sub);">{r.best_for}</td>
          <td class="px-4 py-3">
            <AffiliateCTA
              href={r.affiliate_url}
              label={r.affiliate_label}
              event={r.affiliate_event}
              affiliate={r.affiliate}
              variant="outline"
            />
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<!-- Mobile cards -->
<div class="md:hidden space-y-3">
  {resources.map((r) => (
    <div class="rounded-xl p-4 space-y-3" style="border: 1px solid var(--cb-border); background: var(--cb-bg-card);">
      <div class="flex items-start justify-between gap-2">
        <div>
          <p class="font-semibold text-sm" style="color: var(--cb-text);">{r.provider}</p>
          <p class="text-xs mt-0.5" style="color: var(--cb-text-muted);">{r.type} · {r.price}</p>
        </div>
      </div>
      <p class="text-xs leading-relaxed" style="color: var(--cb-text-sub);">{r.best_for}</p>
      {r.note && <p class="text-xs italic" style="color: var(--cb-text-muted);">{r.note}</p>}
      <AffiliateCTA
        href={r.affiliate_url}
        label={r.affiliate_label}
        event={r.affiliate_event}
        affiliate={r.affiliate}
        variant="primary"
      />
    </div>
  ))}
</div>

<p class="mt-3 text-xs leading-relaxed" style="color: var(--cb-text-muted);">
  {hasAffiliate
    ? 'Affiliate links (buttons) may earn us a commission at no extra cost to you. Plain text links are unaffiliated references and earn us nothing. '
    : 'Links above are unaffiliated references. '}
  <a href="/legal/affiliate-disclosure/" class="underline hover:opacity-80 transition-opacity" style="color: var(--cb-text-muted);">Affiliate disclosure →</a>
</p>
