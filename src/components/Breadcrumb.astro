---
interface Crumb {
  label: string;
  href: string;
}
interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

{crumbs.length > 1 && (
  <nav aria-label="Breadcrumb" class="py-3">
    <ol class="flex flex-wrap items-center gap-1 text-sm" style="color: var(--cb-text-muted);">
      {crumbs.map((crumb, i) => {
        const isLast = i === crumbs.length - 1;
        return (
          <li class="flex items-center gap-1">
            {i > 0 && (
              <svg class="w-3.5 h-3.5 shrink-0" style="color: var(--cb-border);" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            )}
            {isLast ? (
              <span class="font-medium" style="color: var(--cb-text-sub);" aria-current="page">{crumb.label}</span>
            ) : (
              <a href={crumb.href} class="transition-colors hover:opacity-80" style="color: var(--cb-text-muted);">{crumb.label}</a>
            )}
          </li>
        );
      })}
    </ol>
  </nav>
)}
