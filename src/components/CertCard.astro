---
interface Props {
  title: string;
  vendor: string;
  level: string;
  description: string;
  href: string;
  featured?: boolean;
}

const { title, vendor, level, description, href, featured = false } = Astro.props;

const levelBg: Record<string, string> = {
  Associate:    '#f0fdf4',
  Professional: '#eff6ff',
  Expert:       '#faf5ff',
  Specialist:   '#fff7ed',
  Foundational: '#f8fafc',
};
const levelColor: Record<string, string> = {
  Associate:    '#15803d',
  Professional: '#1d4ed8',
  Expert:       '#7c3aed',
  Specialist:   '#c2410c',
  Foundational: '#475569',
};
---

<a
  href={href}
  class="group block rounded-xl border overflow-hidden transition-all duration-200 hover:shadow-md hover:-translate-y-0.5"
  style={featured
    ? 'border-color: var(--cb-accent); background: var(--cb-accent-sub);'
    : 'background: var(--cb-bg-card); border-color: var(--cb-border);'}
>
  <div class="p-5">
    <div class="flex items-start justify-between gap-3 mb-3">
      <div>
        <p class="text-xs font-medium mb-1" style="color: var(--cb-text-muted);">{vendor}</p>
        <h3
          class="font-semibold leading-snug text-sm transition-colors group-hover:text-blue-500"
          style="color: var(--cb-text);"
        >
          {title}
        </h3>
      </div>
      <span
        class="shrink-0 text-xs font-medium px-2 py-0.5 rounded-full"
        style={`background: ${levelBg[level] ?? 'var(--cb-bg-subtle)'}; color: ${levelColor[level] ?? 'var(--cb-text-muted)'};`}
      >
        {level}
      </span>
    </div>
    <p class="text-sm leading-relaxed line-clamp-2" style="color: var(--cb-text-sub);">{description}</p>
    <div class="mt-4 flex items-center gap-1 text-sm font-medium group-hover:gap-2 transition-all" style="color: var(--cb-accent-text);">
      View guide
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </div>
  </div>
  {featured && (
    <div class="px-5 py-2 text-xs font-semibold text-center" style="background: var(--cb-accent); color: #ffffff;">
      Recommended starting certification
    </div>
  )}
</a>
