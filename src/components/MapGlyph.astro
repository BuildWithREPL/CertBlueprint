---
/*
  Three roles and the two moves between them — the career map at its smallest
  legible size.

  Shared rather than copied because it now appears in three places: the header
  pill, the mobile menu, and the badge on the navigator's map card. Three
  hand-maintained copies of the same path is how they end up subtly different.

  Sized in ems so it tracks whatever text it sits beside, and filled with
  currentColor so it takes the colour of that text — white on the header pill,
  violet on the card badge, without either caller restating it.
*/

interface Props {
  /** Width relative to the surrounding font size. */
  size?: string;
  class?: string;
}
const { size = '1.05em', class: className } = Astro.props;
---

<svg
  viewBox="0 0 16 12"
  width={size}
  height={size}
  fill="currentColor"
  class={className}
  aria-hidden="true"
  focusable="false"
  style="flex: none;"
>
  <path d="M3 9 L8 3 L13 8" fill="none" stroke="currentColor" stroke-width="1.1" opacity="0.65" />
  <circle cx="3" cy="9" r="1.8" />
  <circle cx="8" cy="3" r="2.2" />
  <circle cx="13" cy="8" r="1.8" />
</svg>
