---
/**
 * A short, hand-picked list of NetDrill labs: each row shows the lab's kind the
 * way NetDrill's own menu names it (Learn, Build, Fault drill, Capstone, Reps),
 * the lab, and where it sits. Used inside PracticeBlock and on its own.
 */
import { displayTitle, kindLabel, type NetDrillItem } from '../../lib/netdrill';
import NetDrillLink from './NetDrillLink.astro';

interface Props {
  items: NetDrillItem[];
  from: string;
}

const { items, from } = Astro.props;

function where(i: NetDrillItem): string {
  if (i.kind === 'reps') return `A new generated network every rep · ${i.track}`;
  if (i.capstone === 'build') return `Built in milestones${i.minutes ? `, about ${Math.round((i.minutes / 60) * 2) / 2} h` : ''} · ${i.track}`;
  if (i.capstone === 'operate') return `Tickets with one fault each · ${i.track}`;
  if (i.tab === 'designs') return `Whole-network design · ${i.track}`;
  return `${i.group} · ${i.track}`;
}
---

<ul class="nd-list" data-impression={`netdrill:${from}`}>
  {
    items.map((i) => (
      <li>
        <NetDrillLink item={i} from={from} class="nd-row">
          <span class="nd-kind">{kindLabel(i)}</span>
          <span class="nd-text">
            <span class="nd-title">{displayTitle(i)}</span>
            <span class="nd-where">{where(i)}</span>
          </span>
          <svg class="nd-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M9 7h8v8" />
          </svg>
        </NetDrillLink>
      </li>
    ))
  }
</ul>

<style>
  .nd-list > li + li {
    border-top: 1px solid var(--cb-border-sub, var(--cb-border));
  }
  .nd-list :global(.nd-row) {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.6rem 0.25rem;
    text-decoration: none;
    border-radius: 0.375rem;
  }
  .nd-list :global(.nd-row:focus-visible) {
    outline: 2px solid var(--cb-accent);
    outline-offset: 2px;
  }
  .nd-kind {
    flex-shrink: 0;
    width: 6.5rem;
    margin-top: 0.1rem;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--cb-border);
    border-radius: 0.25rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
    color: var(--cb-accent-text);
  }
  .nd-text {
    min-width: 0;
    flex: 1;
  }
  .nd-title {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--cb-text);
  }
  .nd-list :global(.nd-row:hover) .nd-title {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .nd-where {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.75rem;
    color: var(--cb-text-muted);
  }
  .nd-arrow {
    flex-shrink: 0;
    width: 0.9rem;
    height: 0.9rem;
    margin-top: 0.2rem;
    color: var(--cb-text-muted);
  }
  .nd-list :global(.nd-row:hover) .nd-arrow {
    color: var(--cb-accent-text);
  }
</style>
