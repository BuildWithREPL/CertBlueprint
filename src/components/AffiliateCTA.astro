---
interface Props {
  href: string;
  label: string;
  event: string;
  provider?: string;
  note?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  /**
   * true  = real affiliate / tracked link (commissionable). Renders a CTA button,
   *         rel="...sponsored", and fires an `affiliate` analytics event.
   * false = plain reference link (no commission). Renders a muted text link,
   *         rel without "sponsored", and fires an `outbound` analytics event.
   */
  affiliate?: boolean;
}

const {
  href,
  label,
  event,
  provider,
  note,
  variant = 'primary',
  affiliate = true,
} = Astro.props;

const isPlaceholder = href.startsWith('PLACEHOLDER');

const arrowPath =
  'M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14';
---

<div class="inline-flex flex-col items-start gap-1">
  {isPlaceholder ? (
    <span
      class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium cursor-not-allowed opacity-60"
      style={variant === 'outline'
        ? 'border: 1px solid var(--cb-accent); color: var(--cb-accent-text);'
        : variant === 'secondary'
        ? 'background: var(--cb-bg-subtle); color: var(--cb-text);'
        : 'background: var(--cb-accent); color: #ffffff;'}
    >
      {provider && <span class="text-xs opacity-75">{provider}</span>}
      {label}
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={arrowPath}/>
      </svg>
    </span>
  ) : affiliate ? (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer sponsored"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition-opacity hover:opacity-85"
      style={variant === 'outline'
        ? 'border: 1px solid var(--cb-accent); color: var(--cb-accent-text);'
        : variant === 'secondary'
        ? 'background: var(--cb-bg-subtle); color: var(--cb-text);'
        : 'background: var(--cb-accent); color: #ffffff;'}
      data-affiliate-event={event}
      data-affiliate-provider={provider}
      data-impression={`affiliate:${event}`}
      onclick={`if(typeof gtag==='function'){gtag('event','click',{event_category:'affiliate',event_label:'${event}'});}`}
    >
      {provider && <span class="text-xs opacity-75">{provider}</span>}
      {label}
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={arrowPath}/>
      </svg>
    </a>
  ) : (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 text-sm font-medium underline underline-offset-2 transition-opacity hover:opacity-80"
      style="color: var(--cb-text-sub);"
      data-outbound-event={event}
      onclick={`if(typeof gtag==='function'){gtag('event','click',{event_category:'outbound',event_label:'${event}'});}`}
    >
      {label}
      <svg class="w-3 h-3 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={arrowPath}/>
      </svg>
    </a>
  )}
  {note && <p class="text-xs mt-0.5" style="color: var(--cb-text-muted);">{note}</p>}
</div>
