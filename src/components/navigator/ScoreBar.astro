---
interface Props {
  label: string;
  /** 0–100. */
  value: number;
  accent?: string;
  /** Rendered to the right of the bar; omit to show the raw percentage. */
  valueLabel?: string;
  sub?: string;
}

const { label, value, accent, valueLabel, sub } = Astro.props;
const clamped = Math.max(0, Math.min(100, Math.round(value)));
---

<div class="flex flex-col gap-1">
  <div class="flex items-baseline justify-between gap-3">
    <span class="text-sm font-medium" style="color: var(--cb-text);">{label}</span>
    <span class="font-mono text-xs tabular-nums" style="color: var(--cb-text-muted);">
      {valueLabel ?? `${clamped}%`}
    </span>
  </div>

  {/* role="img" with a text label rather than a progressbar role: this is a
      static measurement, not something that updates, and screen readers should
      read it as one statement instead of announcing a live value. */}
  <div class="nav-bar-track" role="img" aria-label={`${label}: ${valueLabel ?? `${clamped}%`}`}>
    <div
      class="nav-bar-fill"
      data-target={clamped}
      style={`width: 0%; ${accent ? `--nav-accent: ${accent};` : ''}`}
    >
    </div>
  </div>

  {sub && <p class="text-xs" style="color: var(--cb-text-muted);">{sub}</p>}
</div>

<script>
  // Bars start at 0 and animate to their measured value on first paint. The
  // animation communicates "this was calculated", which is worth the 700ms.
  // Everything is already correct in the DOM, so nothing depends on this running.
  const fills = document.querySelectorAll<HTMLElement>('.nav-bar-fill[data-target]');
  requestAnimationFrame(() => {
    fills.forEach((el) => {
      el.style.width = `${el.dataset.target ?? 0}%`;
    });
  });
</script>
