---
interface FAQItem {
  question: string;
  answer: string;
}
interface Props {
  items: FAQItem[];
  schema?: boolean;
}

const { items, schema = true } = Astro.props;

const faqSchema = schema
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: items.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : null;
---

<div class="rounded-xl border overflow-hidden" style="border-color: var(--cb-border);">
  {items.map((item) => (
    <details class="faq-item group border-b last:border-b-0" style="border-color: var(--cb-border-sub); background: var(--cb-bg-card);">
      <summary class="flex items-center justify-between gap-3 px-5 py-3.5 cursor-pointer list-none select-none">
        <span class="font-medium text-sm leading-snug" style="color: var(--cb-text);">{item.question}</span>
        <svg
          class="faq-chevron w-4 h-4 shrink-0 transition-transform duration-200"
          fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"
          style="color: var(--cb-text-muted);"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </summary>
      <div class="px-5 pb-4 pt-1">
        <p class="text-sm leading-relaxed" style="color: var(--cb-text-sub);">{item.answer}</p>
      </div>
    </details>
  ))}
</div>

{faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}

<style>
  .faq-item > summary:hover {
    background: var(--cb-bg-subtle);
  }
  details[open] .faq-chevron {
    transform: rotate(180deg);
  }
</style>
