---
// Search index — static, generated at build time
---

<div
  id="search-modal"
  class="hidden fixed inset-0 z-50 flex items-start justify-center pt-[8vh] px-4"
  role="dialog"
  aria-modal="true"
  aria-label="Search"
>
  <!-- Backdrop -->
  <div
    id="search-backdrop"
    class="absolute inset-0"
    style="background: rgba(15,23,42,0.6); backdrop-filter: blur(4px);"
    onclick="document.getElementById('search-modal')?.classList.add('hidden')"
    aria-hidden="true"
  ></div>

  <!-- Panel -->
  <div
    class="relative w-full max-w-xl rounded-xl border shadow-2xl overflow-hidden"
    style="background: var(--cb-bg-card); border-color: var(--cb-border);"
  >
    <!-- Input row -->
    <div class="flex items-center gap-3 px-4 py-3 border-b" style="border-color: var(--cb-border);">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" style="color: var(--cb-text-muted);">
        <circle cx="11" cy="11" r="7" stroke-width="2"/>
        <path d="M21 21l-4.35-4.35" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="Search certs, roles, paths, vendors…"
        autocomplete="off"
        spellcheck="false"
        class="flex-1 bg-transparent text-sm outline-none min-w-0"
        style="color: var(--cb-text);"
        aria-label="Search"
      />
      <kbd class="hidden sm:inline-flex items-center text-xs px-1.5 py-0.5 rounded border font-mono" style="color: var(--cb-text-muted); border-color: var(--cb-border);">Esc</kbd>
    </div>

    <!-- Results -->
    <div id="search-results" class="max-h-72 overflow-y-auto py-1.5">
      <div id="search-default" class="px-4 py-8 text-sm text-center" style="color: var(--cb-text-muted);">
        Start typing to search certifications, roles, career paths and vendors.
      </div>
      <ul id="search-results-list" class="hidden" role="listbox"></ul>
      <div id="search-no-results" class="hidden px-4 py-8 text-sm text-center" style="color: var(--cb-text-muted);">No results found.</div>
    </div>

    <!-- Footer hint -->
    <div class="px-4 py-2 border-t flex items-center justify-between text-xs" style="border-color: var(--cb-border); color: var(--cb-text-muted);">
      <span><kbd class="font-mono border rounded px-1" style="border-color: var(--cb-border);">↑↓</kbd> navigate · <kbd class="font-mono border rounded px-1" style="border-color: var(--cb-border);">↵</kbd> open</span>
      <span>Ctrl+K to open</span>
    </div>
  </div>
</div>

<script>
  interface Doc {
    title: string;
    description: string;
    url: string;
    type: string;
  }

  /* The index is generated at build time (pages/search-index.json.ts) and
     fetched the first time search opens. It used to be a hand-maintained array
     right here, which had already drifted: every certification was listed, but
     no career path and no role page was. Until the fetch lands, these few
     destinations keep search useful rather than empty. */
  const FALLBACK: Doc[] = [
    { title: 'Browse vendors', description: 'Every certification body covered here.', url: '/vendors/', type: 'page' },
    { title: 'IT Career Navigator', description: 'Find the IT work you would actually enjoy.', url: '/navigator/', type: 'page' },
    { title: 'Career paths', description: 'Role-by-role roadmaps.', url: '/paths/', type: 'page' },
    { title: 'Certification comparisons', description: 'Honest head-to-heads.', url: '/compare/', type: 'page' },
  ];

  let SEARCH_INDEX: Doc[] = FALLBACK;
  let indexRequested = false;

  async function ensureIndex(): Promise<void> {
    if (indexRequested) return;
    indexRequested = true;
    try {
      const response = await fetch('/search-index.json');
      if (!response.ok) return;
      const payload = (await response.json()) as { docs?: Doc[] };
      if (Array.isArray(payload.docs) && payload.docs.length > 0) SEARCH_INDEX = payload.docs;
    } catch {
      /* Keep the fallback — an offline visitor still gets the main sections. */
    }
  }


  function simpleSearch(query: string): Doc[] {
    const q = query.toLowerCase().trim();
    if (!q) return [];
    return SEARCH_INDEX.filter(
      d => d.title.toLowerCase().includes(q) || d.description.toLowerCase().includes(q) || d.type.includes(q)
    ).slice(0, 8);
  }

  const typeBadgeStyle: Record<string, string> = {
    certification: 'background:#eff6ff;color:#1d4ed8;',
    vendor: 'background:#f5f3ff;color:#6d28d9;',
    role: 'background:#ecfdf5;color:#047857;',
    path: 'background:#fff7ed;color:#c2410c;',
    comparison: 'background:#f0f9ff;color:#0369a1;',
    trial: 'background:#fefce8;color:#a16207;',
    section: 'background:var(--cb-bg-subtle);color:var(--cb-text-muted);',
    legal: 'background:var(--cb-bg-subtle);color:var(--cb-text-muted);',
    page: 'background:var(--cb-bg-subtle);color:var(--cb-text-muted);',
  };

  const typeLabel: Record<string, string> = {
    certification: 'Cert', vendor: 'Vendor', section: 'Section', legal: 'Legal', page: 'Page',
    role: 'Role', path: 'Path', comparison: 'Compare', trial: 'Trial',
  };

  function renderResults(results: Doc[]) {
    const defaultEl = document.getElementById('search-default')!;
    const list = document.getElementById('search-results-list')!;
    const noRes = document.getElementById('search-no-results')!;

    if (!results.length) {
      defaultEl.classList.add('hidden');
      list.classList.add('hidden');
      noRes.classList.remove('hidden');
      return;
    }
    noRes.classList.add('hidden');
    defaultEl.classList.add('hidden');
    list.classList.remove('hidden');
    list.innerHTML = results.map((r, i) => `
      <li role="option" aria-selected="false">
        <a
          href="${r.url}"
          class="flex items-start gap-3 px-4 py-2.5 transition-colors"
          style="color: var(--cb-text);"
          onmouseover="this.style.background='var(--cb-bg-subtle)'"
          onmouseout="this.style.background=''"
          onfocus="this.style.background='var(--cb-bg-subtle)'"
          onblur="this.style.background=''"
          onclick="document.getElementById('search-modal')?.classList.add('hidden')"
        >
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium truncate">${r.title}</p>
            <p class="text-xs mt-0.5 line-clamp-1" style="color: var(--cb-text-muted);">${r.description}</p>
          </div>
          <span class="shrink-0 mt-0.5 text-xs px-1.5 py-0.5 rounded font-medium" style="${typeBadgeStyle[r.type] ?? ''}">${typeLabel[r.type] ?? r.type}</span>
        </a>
      </li>
    `).join('');
  }

  let searchInited = false;

  function initSearch() {
    const input = document.getElementById('search-input') as HTMLInputElement;
    const defaultEl = document.getElementById('search-default')!;
    const list = document.getElementById('search-results-list')!;
    const noRes = document.getElementById('search-no-results')!;

    input.addEventListener('input', () => {
      if (!input.value.trim()) {
        defaultEl.classList.remove('hidden');
        list.classList.add('hidden');
        noRes.classList.add('hidden');
        return;
      }
      renderResults(simpleSearch(input.value));
    });

    input.addEventListener('keydown', (e) => {
      const items = list.querySelectorAll<HTMLAnchorElement>('a');
      const focused = list.querySelector<HTMLElement>('a:focus');
      const idx = focused ? Array.from(items).indexOf(focused as HTMLAnchorElement) : -1;
      if (e.key === 'ArrowDown') { e.preventDefault(); (items[idx + 1] ?? items[0])?.focus(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); idx <= 0 ? input.focus() : items[idx - 1]?.focus(); }
    });
  }

  const observer = new MutationObserver(() => {
    const modal = document.getElementById('search-modal');
    if (modal && !modal.classList.contains('hidden') && !searchInited) {
      searchInited = true;
      initSearch();
      const input = document.getElementById('search-input') as HTMLInputElement | null;
      void ensureIndex().then(() => {
        if (input && input.value.trim()) renderResults(simpleSearch(input.value));
      });
    }
  });
  const modal = document.getElementById('search-modal');
  if (modal) observer.observe(modal, { attributes: true, attributeFilter: ['class'] });
</script>
