---
// Search index — static, generated at build time
---

<div
  id="search-modal"
  class="hidden fixed inset-0 z-50 flex items-start justify-center pt-[8vh] px-4"
  role="dialog"
  aria-modal="true"
  aria-label="Search"
>
  <!-- Backdrop -->
  <div
    id="search-backdrop"
    class="absolute inset-0"
    style="background: rgba(15,23,42,0.6); backdrop-filter: blur(4px);"
    onclick="document.getElementById('search-modal')?.classList.add('hidden')"
    aria-hidden="true"
  ></div>

  <!-- Panel -->
  <div
    class="relative w-full max-w-xl rounded-xl border shadow-2xl overflow-hidden"
    style="background: var(--cb-bg-card); border-color: var(--cb-border);"
  >
    <!-- Input row -->
    <div class="flex items-center gap-3 px-4 py-3 border-b" style="border-color: var(--cb-border);">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" style="color: var(--cb-text-muted);">
        <circle cx="11" cy="11" r="7" stroke-width="2"/>
        <path d="M21 21l-4.35-4.35" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="Search certifications, vendors, guides…"
        autocomplete="off"
        spellcheck="false"
        class="flex-1 bg-transparent text-sm outline-none min-w-0"
        style="color: var(--cb-text);"
        aria-label="Search"
      />
      <kbd class="hidden sm:inline-flex items-center text-xs px-1.5 py-0.5 rounded border font-mono" style="color: var(--cb-text-muted); border-color: var(--cb-border);">Esc</kbd>
    </div>

    <!-- Results -->
    <div id="search-results" class="max-h-72 overflow-y-auto py-1.5">
      <div id="search-default" class="px-4 py-8 text-sm text-center" style="color: var(--cb-text-muted);">
        Start typing to search certifications, vendors, and guides.
      </div>
      <ul id="search-results-list" class="hidden" role="listbox"></ul>
      <div id="search-no-results" class="hidden px-4 py-8 text-sm text-center" style="color: var(--cb-text-muted);">No results found.</div>
    </div>

    <!-- Footer hint -->
    <div class="px-4 py-2 border-t flex items-center justify-between text-xs" style="border-color: var(--cb-border); color: var(--cb-text-muted);">
      <span><kbd class="font-mono border rounded px-1" style="border-color: var(--cb-border);">↑↓</kbd> navigate · <kbd class="font-mono border rounded px-1" style="border-color: var(--cb-border);">↵</kbd> open</span>
      <span>Ctrl+K to open</span>
    </div>
  </div>
</div>

