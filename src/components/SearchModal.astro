    { id: 'privacy', title: 'Privacy Policy', description: 'Analytics, cookies, and affiliate link handling.', url: '/legal/privacy-policy/', type: 'legal' },
    { id: 'terms', title: 'Terms of Use', description: 'Terms governing use of CertBlueprint.', url: '/legal/terms-of-use/', type: 'legal' },
    { id: 'affiliate', title: 'Affiliate Disclosure', description: 'How affiliate links work on CertBlueprint.', url: '/legal/affiliate-disclosure/', type: 'legal' },
  ];

  type Doc = (typeof SEARCH_INDEX)[number];

  function simpleSearch(query: string): Doc[] {
    const q = query.toLowerCase().trim();
    if (!q) return [];
    return SEARCH_INDEX.filter(
      d => d.title.toLowerCase().includes(q) || d.description.toLowerCase().includes(q) || d.type.includes(q)
    ).slice(0, 8);
  }

  const typeBadgeStyle: Record<string, string> = {
    certification: 'background:#eff6ff;color:#1d4ed8;',
    vendor: 'background:#f5f3ff;color:#6d28d9;',
    section: 'background:var(--cb-bg-subtle);color:var(--cb-text-muted);',
    legal: 'background:var(--cb-bg-subtle);color:var(--cb-text-muted);',
    page: 'background:var(--cb-bg-subtle);color:var(--cb-text-muted);',
  };

  const typeLabel: Record<string, string> = {
    certification: 'Cert', vendor: 'Vendor', section: 'Section', legal: 'Legal', page: 'Page',
  };

  function renderResults(results: Doc[]) {
    const defaultEl = document.getElementById('search-default')!;
    const list = document.getElementById('search-results-list')!;
    const noRes = document.getElementById('search-no-results')!;

    if (!results.length) {
      defaultEl.classList.add('hidden');
      list.classList.add('hidden');
      noRes.classList.remove('hidden');
      return;
    }
    noRes.classList.add('hidden');
    defaultEl.classList.add('hidden');
    list.classList.remove('hidden');
    list.innerHTML = results.map((r, i) => `
      <li role="option" aria-selected="false">
        <a
          href="${r.url}"
          class="flex items-start gap-3 px-4 py-2.5 transition-colors"
          style="color: var(--cb-text);"
          onmouseover="this.style.background='var(--cb-bg-subtle)'"
          onmouseout="this.style.background=''"
          onfocus="this.style.background='var(--cb-bg-subtle)'"
          onblur="this.style.background=''"
          onclick="document.getElementById('search-modal')?.classList.add('hidden')"
        >
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium truncate">${r.title}</p>
            <p class="text-xs mt-0.5 line-clamp-1" style="color: var(--cb-text-muted);">${r.description}</p>
          </div>
          <span class="shrink-0 mt-0.5 text-xs px-1.5 py-0.5 rounded font-medium" style="${typeBadgeStyle[r.type] ?? ''}">${typeLabel[r.type] ?? r.type}</span>
        </a>
      </li>
    `).join('');
  }

  let searchInited = false;

  function initSearch() {
    const input = document.getElementById('search-input') as HTMLInputElement;
    const defaultEl = document.getElementById('search-default')!;
    const list = document.getElementById('search-results-list')!;
    const noRes = document.getElementById('search-no-results')!;

    input.addEventListener('input', () => {
      if (!input.value.trim()) {
        defaultEl.classList.remove('hidden');
        list.classList.add('hidden');
        noRes.classList.add('hidden');
        return;
      }
      renderResults(simpleSearch(input.value));
    });

    input.addEventListener('keydown', (e) => {
      const items = list.querySelectorAll<HTMLAnchorElement>('a');
      const focused = list.querySelector<HTMLElement>('a:focus');
      const idx = focused ? Array.from(items).indexOf(focused as HTMLAnchorElement) : -1;
      if (e.key === 'ArrowDown') { e.preventDefault(); (items[idx + 1] ?? items[0])?.focus(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); idx <= 0 ? input.focus() : items[idx - 1]?.focus(); }
    });
  }

  const observer = new MutationObserver(() => {
    const modal = document.getElementById('search-modal');
    if (modal && !modal.classList.contains('hidden') && !searchInited) {
      searchInited = true;
      initSearch();
    }
  });
  const modal = document.getElementById('search-modal');
  if (modal) observer.observe(modal, { attributes: true, attributeFilter: ['class'] });
</script>
