---
import '../styles/global.css';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';

interface Props {
  title: string;
  description: string;
  /** Pass false to omit the canonical tag entirely (e.g. the 404 page). */
  canonicalUrl?: string | false;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  breadcrumbs?: Array<{ label: string; href: string }>;
  structuredData?: Record<string, unknown> | null;
  /** For pages whose content only exists client-side — nothing for a crawler to index. */
  noindex?: boolean;
}

const {
  title: rawTitle,
  description: rawDescription,
  canonicalUrl,
  ogTitle,
  ogDescription,
  ogImage: explicitOgImage,
  breadcrumbs,
  structuredData,
  noindex = false,
} = Astro.props;

const siteUrl = 'https://certblueprint.com';

// ─── Snippet hygiene ─────────────────────────────────────────────
// Search results cut titles near 60 characters and descriptions near 160.
// Long page titles drop the brand suffix rather than losing their own words,
// and descriptions are clipped at a word boundary instead of mid-word.
const BRAND_SUFFIX = ' | CertBlueprint';
const title =
  rawTitle.length > 60 && rawTitle.endsWith(BRAND_SUFFIX) ? rawTitle.slice(0, -BRAND_SUFFIX.length) : rawTitle;

function clip(text: string, max: number): string {
  if (text.length <= max) return text;
  const cut = text.slice(0, max - 1);
  const space = cut.lastIndexOf(' ');
  return cut.slice(0, space > max * 0.6 ? space : cut.length).replace(/[\s,;:.—–-]+$/, '') + '…';
}
const description = clip(rawDescription, 158);

// ─── Social image: most specific existing section image wins ─────
// Images are generated by scripts/generate-og-images.py into public/og/.
// Checked on disk at build time (static output, run from the project root).
function sectionOgImage(pathname: string): string {
  const [first, second] = pathname.split('/').filter(Boolean);
  const candidates = [
    first === 'vendors' && second ? `/og/vendor-${second}.png` : '',
    first ? `/og/${first}.png` : '',
  ];
  return candidates.find((c) => c && existsSync(join(process.cwd(), 'public', c))) ?? '/og-default.png';
}
const ogImage = explicitOgImage ?? sectionOgImage(Astro.url.pathname);

// canonicalUrl={false} omits the tag — for pages like the 404 that are not a
// real address of anything.
const resolvedCanonical = canonicalUrl === false ? null : (canonicalUrl ?? Astro.url.href);
const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDescription = clip(ogDescription ?? rawDescription, 200);

const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((crumb, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: crumb.label,
        item: crumb.href.startsWith('http') ? crumb.href : `${siteUrl}${crumb.href}`,
      })),
    }
  : null;

// ─── Sitewide entity schema (brand understanding in search) ──────
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'CertBlueprint',
  url: siteUrl,
  logo: `${siteUrl}/og-default.png`,
  description: 'IT certification roadmaps, study plans, and curated free and paid resources.',
  parentOrganization: { '@type': 'Organization', name: 'SureWhyNot', url: 'https://surewhynot.app' },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'CertBlueprint',
  url: siteUrl,
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    {/* Impact.com verification requires the non-standard `value` attribute verbatim,
        which the HTML type definitions reject — emit it raw to keep output identical. */}
    <Fragment set:html={`<meta name='impact-site-verification' value='3b615039-a364-4715-829c-86e2ab2e588a'>`} />

    <!-- ─── Prevent theme flash ──────────────────────────── -->
    <script is:inline>
      (function() {
        var t = localStorage.getItem('cb-theme');
        if (t && t !== 'light') document.documentElement.setAttribute('data-theme', t);
      })();
    </script>

    <!-- ─── Primary Meta ──────────────────────────────────── -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {resolvedCanonical && <link rel="canonical" href={resolvedCanonical} />}

    <!-- ─── Open Graph ────────────────────────────────────── -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:url" content={resolvedCanonical ?? Astro.url.href} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:site_name" content="CertBlueprint" />

    <!-- ─── Twitter / X Card ─────────────────────────────── -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDescription} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- ─── Favicon ───────────────────────────────────────── -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- ─── CookieYes ─────────────────────────────────────── -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/959418c8d315380cf4e272255dc66aff/script.js"
    ></script>

    <!-- ─── Google Tag Manager ────────────────────────────── -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-N4MMF28L' + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-N4MMF28L');
    </script>

    <!-- ─── Google Analytics 4 ────────────────────────────── -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-TZF5JSYH7W"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-TZF5JSYH7W');
    </script>

    <!-- ─── Google AdSense ────────────────────────────────── -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7167291111213614"
      crossorigin="anonymous"
    ></script>

    <!-- ─── Structured Data ───────────────────────────────── -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>

  <body class="min-h-screen flex flex-col">

    <!-- ─── Google Tag Manager (noscript) ─────────────────── -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-N4MMF28L"
        height="0" width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>

    <Header />
    <SearchModal />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />

    <!-- ─── First-party usage telemetry (src/scripts/telemetry.js) ── -->
    <script>
      import '../scripts/telemetry.js';
    </script>

    <!-- ─── Keyboard shortcut: Ctrl+K ─────────────────────── -->
    <script>
      document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
          e.preventDefault();
          const modal = document.getElementById('search-modal');
          if (modal) {
            modal.classList.toggle('hidden');
            if (!modal.classList.contains('hidden')) {
              setTimeout(() => (modal.querySelector('#search-input') as HTMLInputElement | null)?.focus(), 30);
            }
          }
        }
        if (e.key === 'Escape') {
          const modal = document.getElementById('search-modal');
          if (modal && !modal.classList.contains('hidden')) {
            modal.classList.add('hidden');
          }
        }
      });
    </script>

  </body>
</html>
