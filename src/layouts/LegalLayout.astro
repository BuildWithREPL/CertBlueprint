---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

interface Props {
  title: string;
  description: string;
  effectiveDate: string;
  lastUpdated: string;
}

const { title, description, effectiveDate, lastUpdated } = Astro.props;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: title, href: '#' },
];
---

<BaseLayout
  title={`${title} | CertBlueprint`}
  description={description}
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10">
    <Breadcrumb crumbs={breadcrumbs} />

    <header class="mt-4 mb-8 pb-6" style="border-bottom: 1px solid var(--cb-border);">
      <h1 class="text-2xl sm:text-3xl font-bold mb-3" style="color: var(--cb-text);">{title}</h1>
      <p class="text-sm" style="color: var(--cb-text-muted);">
        Effective date: <strong style="color: var(--cb-text-sub);">{effectiveDate}</strong> ·
        Last updated: <strong style="color: var(--cb-text-sub);">{lastUpdated}</strong>
      </p>
      <p class="text-sm mt-1" style="color: var(--cb-text-muted);">
        Operated by SureWhyNot · <a href="mailto:contact@surewhynot.app" class="underline hover:opacity-80 transition-opacity" style="color: var(--cb-text-muted);">contact@surewhynot.app</a>
      </p>
    </header>

    <div class="prose-legal space-y-8 text-[0.95rem] leading-relaxed" style="color: var(--cb-text-sub);">
      <slot />
    </div>

    <div class="mt-12 pt-6" style="border-top: 1px solid var(--cb-border);">
      <p class="text-sm" style="color: var(--cb-text-muted);">
        Questions about this page? Email <a href="mailto:contact@surewhynot.app" class="underline hover:opacity-80 transition-opacity" style="color: var(--cb-text-muted);">contact@surewhynot.app</a>.
      </p>
      <div class="mt-4 flex flex-wrap gap-3 text-sm">
        <a href="/legal/privacy-policy/" class="hover:opacity-80 transition-opacity" style="color: var(--cb-accent);">Privacy Policy</a>
        <a href="/legal/terms-of-use/" class="hover:opacity-80 transition-opacity" style="color: var(--cb-accent);">Terms of Use</a>
        <a href="/legal/affiliate-disclosure/" class="hover:opacity-80 transition-opacity" style="color: var(--cb-accent);">Affiliate Disclosure</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .prose-legal :global(h2) {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--cb-text);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--cb-border-sub);
  }
  .prose-legal :global(h3) {
    font-size: 1rem;
    font-weight: 600;
    color: var(--cb-text);
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .prose-legal :global(p) {
    margin-bottom: 1rem;
    line-height: 1.7;
  }
  .prose-legal :global(ul) {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
    color: var(--cb-text-sub);
  }
  .prose-legal :global(ul li) {
    margin-bottom: 0.25rem;
  }
  .prose-legal :global(a) {
    text-decoration: underline;
    color: var(--cb-accent);
  }
  .prose-legal :global(strong) {
    font-weight: 600;
    color: var(--cb-text);
  }
</style>
