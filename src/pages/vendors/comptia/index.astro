---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CertCard from '../../../components/CertCard.astro';
import FAQAccordion from '../../../components/FAQAccordion.astro';
import { getEntry } from 'astro:content';

const comptia = await getEntry('vendors', 'comptia');
const { data } = comptia;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Vendors', href: '/vendors/' },
  { label: 'CompTIA', href: '/vendors/comptia/' },
];

const upcomingCerts = [
  { title: 'CompTIA Tech+', level: 'Foundation', description: 'Pre-A+ foundational cert for absolute beginners exploring whether IT is the right career path.' },
  { title: 'CompTIA Data+', level: 'Intermediate', description: 'Data analytics: mining, manipulation, visualization, and data-driven decision making.' },
  { title: 'CompTIA Project+', level: 'Intermediate', description: 'IT project management fundamentals—initiation, planning, execution, and delivery.' },
  { title: 'CompTIA SecurityX (formerly CASP+)', level: 'Advanced', description: 'Advanced security practitioner credential for architects and senior security engineers.' },
];
---

<BaseLayout title={data.seo_title} description={data.seo_description} breadcrumbs={breadcrumbs}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb crumbs={breadcrumbs} />

    <header class="mt-3 mb-8 max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--cb-accent-text);">Vendor</p>
      <h1 class="text-2xl sm:text-3xl font-bold mb-3" style="color: var(--cb-text);">CompTIA Certifications Guide</h1>
      <p class="text-sm leading-relaxed" style="color: var(--cb-text-sub);">{data.overview}</p>
    </header>

    <!-- Why CompTIA -->
    <section class="py-8 border-t" style="border-color: var(--cb-border);" aria-labelledby="why-comptia-heading">
      <div class="max-w-3xl">
        <h2 id="why-comptia-heading" class="text-base font-bold mb-3" style="color: var(--cb-text);">Why CompTIA certifications matter</h2>
        <div class="space-y-4 text-sm leading-relaxed" style="color: var(--cb-text-sub);">
          {data.why_vendor_matters.split('\n\n').map((para: string) => (
            <p>{para}</p>
          ))}
        </div>
      </div>
    </section>

    <!-- Who it's for -->
    <section class="py-8 border-t" style="border-color: var(--cb-border);" aria-labelledby="audience-comptia-heading">
      <div class="max-w-3xl">
        <h2 id="audience-comptia-heading" class="text-base font-bold mb-3" style="color: var(--cb-text);">Who CompTIA certifications are for</h2>
        <div class="space-y-3">
          {[
            { role: 'Career changers entering IT', detail: 'CompTIA certifications require no prior work experience and are achievable with self-study. They provide the employer-recognized proof of competence that career changers need to get their first interview.' },
            { role: 'Government and defense IT workers', detail: 'Security+ is mandated by DoD Directive 8570/8140 for IT security positions at government agencies and defense contractors. If your target employer is in the public sector, Security+ may be non-negotiable.' },
            { role: 'IT support and help desk professionals', detail: 'CompTIA A+ is the recognized baseline for IT support, desktop support, and help desk roles. Most employers hiring for entry-level IT support recognize it explicitly.' },
            { role: 'Security analysts and SOC professionals', detail: 'CySA+ (Cybersecurity Analyst) builds on Security+ for threat detection, monitoring, and incident response roles. CASP+ targets senior security architects and practitioners.' },
          ].map((item) => (
            <div class="rounded-xl border p-4" style="background: var(--cb-bg-card); border-color: var(--cb-border);">
              <p class="font-semibold text-sm mb-1" style="color: var(--cb-text);">{item.role}</p>
              <p class="text-sm leading-relaxed" style="color: var(--cb-text-sub);">{item.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Salary and career impact -->
    <section class="py-8 border-t" style="border-color: var(--cb-border);" aria-labelledby="salary-comptia-heading">
      <div class="max-w-3xl">
        <h2 id="salary-comptia-heading" class="text-base font-bold mb-3" style="color: var(--cb-text);">Career and salary impact</h2>
        <p class="text-sm leading-relaxed mb-3" style="color: var(--cb-text-sub);">
          CompTIA certifications have a stronger impact on hiring eligibility than on salary alone — they get you in the door. Security+ in particular is a binary requirement for a large segment of government IT jobs: you either have it or you don't qualify. For private sector roles, Security+ and Network+ consistently appear in entry-level and junior job postings and signal that a candidate has verified, structured IT knowledge.
        </p>
        <p class="text-sm leading-relaxed" style="color: var(--cb-text-sub);">
          Entry-level IT support roles with A+ typically start at $40,000–$55,000. Network engineers with Network+ as part of their profile earn $55,000–$80,000. Security analysts with Security+ enter cybersecurity roles at $60,000–$85,000 depending on experience and location. CySA+ and CASP+ holders in senior roles can earn $90,000–$130,000+. CompTIA certifications are most powerful when paired with hands-on experience — the cert opens the door, the experience keeps you in the room.
        </p>
      </div>
    </section>

    <!-- Study difficulty and timeline -->
    <section class="py-8 border-t" style="border-color: var(--cb-border);" aria-labelledby="difficulty-comptia-heading">
      <div class="max-w-3xl">
        <h2 id="difficulty-comptia-heading" class="text-base font-bold mb-4" style="color: var(--cb-text);">Study difficulty and time investment</h2>
        <div class="space-y-3">
          {[
            { cert: 'CompTIA A+', difficulty: 'Beginner', time: '2–3 months part-time', detail: 'Two-exam certification (Core 1 and Core 2). Covers PC hardware, operating systems, networking basics, and troubleshooting. Achievable without prior IT experience. Plenty of free study material available.' },
            { cert: 'CompTIA Network+', difficulty: 'Beginner–Moderate', time: '2–4 months part-time', detail: 'Single exam. Requires understanding TCP/IP fundamentals, routing concepts, network troubleshooting, and wireless. Most candidates with some networking exposure are ready in 2–3 months.' },
            { cert: 'CompTIA Security+', difficulty: 'Moderate', time: '4–8 weeks with IT background', detail: 'Single exam (SY0-701). Covers a broad range of security domains. Candidates with existing IT or networking experience typically study 4–8 weeks. Those starting from scratch should build IT fundamentals first.' },
            { cert: 'CompTIA CySA+', difficulty: 'Moderate–Hard', time: '3–5 months', detail: 'Assumes Security+ level knowledge plus some hands-on experience with threat detection and incident response. More scenario-focused than Security+. Recommended after 1–2 years of security work experience.' },
          ].map((item) => (
            <div class="rounded-xl border p-4" style="background: var(--cb-bg-card); border-color: var(--cb-border);">
              <div class="flex items-center justify-between mb-1.5">
                <p class="font-semibold text-sm" style="color: var(--cb-text);">{item.cert}</p>
                <div class="flex gap-2">
                  <span class="text-xs px-2 py-0.5 rounded-full" style="background: var(--cb-bg-subtle); color: var(--cb-text-muted);">{item.difficulty}</span>
                  <span class="text-xs px-2 py-0.5 rounded-full" style="background: var(--cb-accent-sub); color: var(--cb-accent-text);">{item.time}</span>
                </div>
              </div>
              <p class="text-sm leading-relaxed" style="color: var(--cb-text-sub);">{item.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Cert structure -->
    <section class="py-8 border-t" style="border-color: var(--cb-border);" aria-labelledby="tracks-heading">
      <h2 id="tracks-heading" class="text-base font-bold mb-4" style="color: var(--cb-text);">Certification tracks</h2>
      <div class="grid sm:grid-cols-2 gap-3 max-w-4xl">
        {data.certification_tracks.map((track) => (
          <div class="rounded-xl border p-4" style="background: var(--cb-bg-card); border-color: var(--cb-border);">
            <div class="flex items-center justify-between mb-1.5">
              <h3 class="font-semibold text-sm" style="color: var(--cb-text);">{track.name}</h3>
              <span class="text-xs px-2 py-0.5 rounded-full" style="color: var(--cb-text-muted); background: var(--cb-bg-subtle);">{track.level}</span>
            </div>
            <p class="text-sm leading-relaxed" style="color: var(--cb-text-sub);">{track.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Live guides -->
    <section class="py-8 border-t" style="border-color: var(--cb-border);" aria-labelledby="available-heading">
      <h2 id="available-heading" class="text-base font-bold mb-4" style="color: var(--cb-text);">Available guides</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-5xl">
        <CertCard
          title="CompTIA A+ (220-1201 & 220-1202)"
          vendor="CompTIA"
          level="Foundation"
          description="The recognized starting point for an IT career. Two exams covering hardware, operating systems, networking, security, and troubleshooting for support roles."
          href="/vendors/comptia/a-plus/"
          featured={true}
        />
        <CertCard
          title="CompTIA Network+ (N10-009)"
          vendor="CompTIA"
          level="Associate"
          description="The vendor-neutral networking credential. Covers TCP/IP, routing, switching, wireless, security, and troubleshooting across any platform."
          href="/vendors/comptia/network-plus/"
        />
        <CertCard
          title="CompTIA Security+ (SY0-701)"
          vendor="CompTIA"
          level="Associate"
          description="The DoD-approved baseline cybersecurity certification. Covers threats, vulnerabilities, identity management, cryptography, and incident response."
          href="/vendors/comptia/security-plus/"
          featured={true}
        />
        <CertCard
          title="CompTIA CySA+ (CS0-003)"
          vendor="CompTIA"
          level="Intermediate"
          description="Cybersecurity Analyst. Hands-on security monitoring, threat detection, vulnerability management, and incident response—the step up from Security+."
          href="/vendors/comptia/cysa-plus/"
        />
        <CertCard
          title="CompTIA PenTest+ (PT0-003)"
          vendor="CompTIA"
          level="Intermediate"
          description="Penetration testing and ethical hacking. Planning, reconnaissance, exploitation, post-exploitation, and reporting across the full engagement lifecycle."
          href="/vendors/comptia/pentest-plus/"
        />
        <CertCard
          title="CompTIA Cloud+ (CV0-004)"
          vendor="CompTIA"
          level="Intermediate"
          description="Vendor-neutral cloud operations. Architecture, deployment, security, operations, and DevOps fundamentals across multi-cloud environments."
          href="/vendors/comptia/cloud-plus/"
        />
        <CertCard
          title="CompTIA Linux+ (XK0-005)"
          vendor="CompTIA"
          level="Intermediate"
          description="Linux system administration. Command line, system management, security, scripting, containers, and troubleshooting on the OS that runs the cloud."
          href="/vendors/comptia/linux-plus/"
        />
      </div>
    </section>

    <!-- More certs -->
    <section class="py-8 border-t" style="border-color: var(--cb-border);" aria-labelledby="more-heading">
      <h2 id="more-heading" class="text-base font-bold mb-4" style="color: var(--cb-text);">More CompTIA certifications</h2>
      <div class="grid sm:grid-cols-2 gap-3 max-w-4xl">
        {upcomingCerts.map((cert) => (
          <div class="rounded-xl border p-4" style="background: var(--cb-bg-card); border-color: var(--cb-border);">
            <div class="flex items-center justify-between mb-1.5">
              <h3 class="font-semibold text-sm" style="color: var(--cb-text);">{cert.title}</h3>
              <span class="text-xs px-2 py-0.5 rounded-full" style="color: var(--cb-text-muted); background: var(--cb-bg-subtle);">{cert.level}</span>
            </div>
            <p class="text-xs leading-relaxed" style="color: var(--cb-text-sub);">{cert.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-8 border-t" style="border-color: var(--cb-border);" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-base font-bold mb-4" style="color: var(--cb-text);">Frequently asked questions</h2>
      <div class="max-w-3xl">
        <FAQAccordion items={data.faq} />
      </div>
    </section>

    <!-- Cross-links to related vendors -->
    <section class="py-8 border-t" style="border-color: var(--cb-border);" aria-labelledby="related-vendors-heading">
      <h2 id="related-vendors-heading" class="text-base font-bold mb-4" style="color: var(--cb-text);">Related cert paths</h2>
      <div class="grid sm:grid-cols-3 gap-3 max-w-3xl">
        <a href="/vendors/cisco/ccna/" class="rounded-xl border p-4 transition-colors block" style="background: var(--cb-bg-card); border-color: var(--cb-border);">
          <p class="font-semibold text-sm mb-1" style="color: var(--cb-text);">Cisco CCNA</p>
          <p class="text-xs leading-relaxed" style="color: var(--cb-text-sub);">Pair Network+ knowledge with Cisco-specific depth for networking roles.</p>
        </a>
        <a href="/vendors/aws/aws-saa/" class="rounded-xl border p-4 transition-colors block" style="background: var(--cb-bg-card); border-color: var(--cb-border);">
          <p class="font-semibold text-sm mb-1" style="color: var(--cb-text);">AWS Solutions Architect</p>
          <p class="text-xs leading-relaxed" style="color: var(--cb-text-sub);">Security+ holders moving into cloud security roles often pursue AWS next.</p>
        </a>
        <a href="/vendors/microsoft/az-104/" class="rounded-xl border p-4 transition-colors block" style="background: var(--cb-bg-card); border-color: var(--cb-border);">
          <p class="font-semibold text-sm mb-1" style="color: var(--cb-text);">Microsoft AZ-104</p>
          <p class="text-xs leading-relaxed" style="color: var(--cb-text-sub);">Azure Administrator for CompTIA-certified professionals in Microsoft environments.</p>
        </a>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-8 border-t" style="border-color: var(--cb-border);">
      <div class="rounded-2xl p-7 text-center max-w-2xl text-white" style="background: linear-gradient(135deg, #c0392b, #922b21);">
        <h2 class="text-xl font-bold mb-2">Start with CompTIA Security+</h2>
        <p class="text-sm mb-5 leading-relaxed" style="color: #fadbd8;">The DoD-approved baseline cybersecurity cert. Study path, exam details, free resources, and recommended courses—all in one place.</p>
        <a href="/vendors/comptia/security-plus/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold transition-colors" style="background: white; color: #c0392b;">
          View Security+ guide
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </section>

  </div>
</BaseLayout>
