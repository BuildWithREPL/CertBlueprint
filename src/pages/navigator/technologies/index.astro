---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/navigator.css';
import { TECHNOLOGIES, TECHNOLOGY_CATEGORIES } from '../../../lib/navigator/data/technologies';
import { CAPABILITY_BY_SLUG } from '../../../lib/navigator/data/capabilities';
import { ROLE_BY_SLUG } from '../../../lib/navigator/data/roles';
import { ACCENT_VAR, DOMAIN_BY_ID } from '../../../lib/navigator/data/domains';

const title = 'IT Technology Map — What Each Tool Actually Proves | CertBlueprint';
const description =
  'Every technology mapped to the capabilities it represents, the fields it belongs to, the roles that use it, and the certifications that cover it.';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Career Navigator', href: '/navigator/' },
  { label: 'Technology map', href: '/navigator/technologies/' },
];

const byCategory = TECHNOLOGY_CATEGORIES.map((category) => ({
  category,
  items: TECHNOLOGIES.filter((t) => t.category === category),
})).filter((g) => g.items.length > 0);
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-6">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight" style="color: var(--cb-text);">
      The technology map
    </h1>
    <p class="mt-3 text-base leading-relaxed" style="color: var(--cb-text-sub); max-width: 64ch;">
      Products come and go; capabilities do not. Each entry below shows what working with that
      technology actually demonstrates, which fields it sits in, and where it leads. This is the same
      graph the
      <a href="/navigator/inventory/" style="color: var(--cb-accent-text);">technology inventory</a> uses to
      work out what your experience adds up to.
    </p>
    <p class="mt-3 font-mono text-xs" style="color: var(--cb-text-muted);">
      technology → capability → field → role → certification
    </p>
  </section>

  {
    byCategory.map((group) => (
      <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
        <h2 class="text-xs font-bold uppercase tracking-widest mb-3" style="color: var(--cb-text-muted);">
          {group.category}
        </h2>
        <div class="grid md:grid-cols-2 gap-3">
          {group.items.map((tech) => (
            <div class="nav-card p-4">
              <div class="flex items-baseline justify-between gap-2 mb-1">
                <h3 class="font-semibold text-base" style="color: var(--cb-text);">
                  {tech.name}
                </h3>
                <div class="flex gap-1 shrink-0">
                  {tech.domains.map((id) => {
                    const d = DOMAIN_BY_ID[id];
                    return d ? (
                      <span class="nav-pill" style={`--nav-accent: var(${ACCENT_VAR[d.accent]});`}>
                        {d.name}
                      </span>
                    ) : null;
                  })}
                </div>
              </div>

              <p class="text-sm leading-relaxed mb-3" style="color: var(--cb-text-sub);">
                {tech.blurb}
              </p>

              <p class="text-xs font-semibold mb-1" style="color: var(--cb-text-muted);">
                Demonstrates
              </p>
              <p class="text-xs leading-relaxed mb-3" style="color: var(--cb-text-sub);">
                {tech.capabilities
                  .map((slug) => CAPABILITY_BY_SLUG[slug]?.name)
                  .filter(Boolean)
                  .join(' · ')}
              </p>

              {tech.revelation && (
                <p
                  class="text-xs leading-relaxed mb-3 p-2.5 rounded-md"
                  style="color: var(--cb-text-sub); background: var(--cb-bg-subtle);"
                >
                  {tech.revelation}
                </p>
              )}

              <p class="text-xs font-semibold mb-1" style="color: var(--cb-text-muted);">
                Used by
              </p>
              <div class="flex flex-wrap gap-x-3 gap-y-1">
                {tech.roles
                  .map((slug) => ROLE_BY_SLUG[slug])
                  .filter(Boolean)
                  .map((role) => (
                    <a
                      href={`/navigator/roles/${role.slug}/`}
                      class="text-xs font-medium"
                      style="color: var(--cb-accent-text);"
                    >
                      {role.name}
                    </a>
                  ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>
