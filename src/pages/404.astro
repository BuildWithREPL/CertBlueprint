---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | CertBlueprint"
  description="The page you are looking for does not exist."
>
  <div class="max-w-2xl mx-auto px-4 py-24 text-center">
    <p class="text-5xl font-bold mb-4" style="color: var(--cb-border);">404</p>
    <h1 class="text-2xl font-bold mb-3" style="color: var(--cb-text);">Page not found</h1>
    <p class="text-sm mb-8 leading-relaxed" style="color: var(--cb-text-sub);">
      The page you are looking for does not exist or has been moved.
    </p>
    <div class="flex flex-wrap gap-3 justify-center">
      <a href="/" class="px-4 py-2 text-white text-sm font-medium rounded-lg transition-opacity hover:opacity-85" style="background: var(--cb-accent);">
        Go to homepage
      </a>
      <a href="/vendors/cisco/ccna/" class="px-4 py-2 text-sm font-medium rounded-lg transition-opacity hover:opacity-80" style="border: 1px solid var(--cb-border); background: var(--cb-bg-card); color: var(--cb-text-sub);">
        CCNA guide
      </a>
    </div>
  </div>
</BaseLayout>
